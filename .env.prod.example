# Copie este arquivo para ".env" na VM (mesma pasta do docker-compose.prod.yml) e preencha os valores reais.
# "docker compose --env-file .env -f docker-compose.prod.yml up -d" lê essas variáveis automaticamente.

# Senha do usuário do Postgres (escolha uma senha forte)
DB_PASSWORD=troque-por-uma-senha-forte

# Chave usada para assinar os tokens JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=troque-por-uma-chave-bem-longa-e-aleatoria

# URL pública que vai no e-mail de redefinição de senha (IP ou domínio da VM)
FRONTEND_RESET_SENHA_URL=http://SEU_IP_OU_DOMINIO/redefinir-senha

# Opcional
MAIL_REMETENTE=no-reply@euroforma.local
ANTHROPIC_API_KEY=
